{
  "$schema": "https://opencode.ai/config.json",

  // Token optimization & efficiency plugins.
  // All are auto-loaded at opencode launch; no per-session setup needed.
  // Versions pinned — bump deliberately.
  "plugin": [
    "@dietrichgebert/ponytail@4.9.0",
    "token-optimizer-opencode@1.1.0",
    "rtk-for-opencode@0.1.5",
    "@javargasm/opencode-graphify@0.2.0",
    "opencode-token-usage@1.0.0",
    // Dominant community plugin: 11 subagents, LSP/AST tools, multi-agent
    // team mode on git worktrees. Heavyweight — remove here first if hooks
    // ever fight the token-optimization set above.
    "oh-my-openagent@4.19.4"
  ],

  // Shared MCP servers (same trio Claude Code gets from bootstrap.sh).
  // Remote servers add no local deps; GitHub OAuth fires on first use.
  // Serena is installed by bootstrap.sh via uv; opencode skips a local
  // server whose binary is missing.
  "mcp": {
    "serena": {
      "type": "local",
      "command": ["serena", "start-mcp-server", "--context", "ide"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/",
      "enabled": true
    }
  }
}