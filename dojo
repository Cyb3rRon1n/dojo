#!/usr/bin/env bash
#
# dojo — day-to-day front end over the dojo engine (lib.sh). No args opens
# the whiptail Main Menu; a subcommand runs the same action non-interactively
# so it stays scriptable/headless.
#
#   dojo                 open the Main Menu (install / update / services / login / ...)
#   dojo install [--tools LIST] [--repos SLUG]
#   dojo update          git pull + re-wire the whole stack
#   dojo repos           git pull + submodule update for the repos workspace
#   dojo status          versions, GitHub auth, whether you're behind origin
#   dojo doctor          verify every wiring point; exit 1 if anything is broken
#   dojo tokens          live token usage / cache refresh / context-fill thresholds
#   dojo menu            open the Main Menu explicitly
#
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
DOJO_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# shellcheck disable=SC1091
source "$DOJO_DIR/lib.sh"

usage() {
  cat <<'EOF'
usage: dojo [command]

  (no command)  open the Main Menu (install / update / services / login / ...)
  install       install tools + wire everything up (--tools LIST --repos SLUG)
  update        git pull + re-run the whole wire-up (self-heal)
  repos         git pull + submodule update for the projects/github/repos workspace
  status        versions, GitHub auth, whether you're behind origin
  doctor        verify every wiring point is intact; exit 1 if broken
  tokens        live token usage / cache refresh / context-fill thresholds
  menu          open the Main Menu
EOF
  exit 1
}

cmd="${1:-}"
case "$cmd" in
  "" | menu)
    exec "$DOJO_DIR/menu.sh" "${@:2}"
    ;;
  install)
    shift
    run_install "$@"
    ;;
  update)
    run_update
    ;;
  repos)
    dojo_repos
    ;;
  status)
    dojo_status
    ;;
  doctor)
    dojo_doctor
    ;;
  tokens)
    shift
    exec python3 "$DOJO_DIR/dojo-tokens.py" "$@"
    ;;
  *)
    usage
    ;;
esac
