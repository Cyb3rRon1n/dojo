#!/usr/bin/env bash
#
# dojo — day-to-day wrapper around the dojo stack: update, status.
# For first-time setup on a fresh machine, use install.sh instead.
#
set -euo pipefail

DOJO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

usage() { printf 'usage: dojo <update|status>\n'; exit 1; }

git_auth_status() {
  if command -v ssh >/dev/null 2>&1 && ssh -o BatchMode=yes -o ConnectTimeout=5 -T git@github.com 2>&1 | grep -q "successfully authenticated"; then
    echo "GitHub SSH OK"
  elif command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    echo "GitHub HTTPS OK (gh)"
  else
    echo "NOT configured — see README"
  fi
}

cmd="${1:-}"
case "$cmd" in
  update)
    git -C "$DOJO_DIR" pull --ff-only
    "$DOJO_DIR/bootstrap.sh"
    ;;
  status)
    rev="$(git -C "$DOJO_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')"
    echo "dojo:      $DOJO_DIR @ $rev"
    git -C "$DOJO_DIR" fetch -q origin 2>/dev/null || true
    behind="$(git -C "$DOJO_DIR" rev-list --count 'HEAD..@{upstream}' 2>/dev/null || echo '?')"
    if [[ "$behind" == "0" ]]; then
      echo "           up to date"
    else
      echo "           $behind commit(s) behind — run 'dojo update'"
    fi
    echo "opencode:  $(command -v opencode >/dev/null 2>&1 && opencode --version || echo MISSING)"
    echo "claude:    $(command -v claude >/dev/null 2>&1 && claude --version || echo MISSING)"
    echo "plugins:   $(command -v claude >/dev/null 2>&1 && claude plugin list 2>/dev/null | grep -ciE 'ponytail|token-optimizer' || echo 0) of 2 (claude)"
    echo "rtk:       $(command -v rtk >/dev/null 2>&1 && rtk --version | head -1 || echo MISSING)"
    echo "graphify:  $(command -v graphify >/dev/null 2>&1 && graphify --version | head -1 || echo MISSING)"
    echo "auth:      $(git_auth_status)"
    ;;
  *)
    usage
    ;;
esac
